.DS_Store
**/.DS_Store

# RENADIA · respuestas recogidas (datos, no versionar)
Bases de datos/DNP/respuestas-export/
Bases de datos/leyes-senado/supers/

# Fotos de candidatos · staging local (se suben a S3, no al repo)
fotos-candidatos/pendientes/
fotos-candidatos/subidas/
fotos-candidatos/pendientes.csv

# Datos presidenciales formato endoso (se suben a S3, no al repo)
Bases de datos/output_presidencial_endoso/

# Datos Asamblea 2023 formato endoso (se suben a S3, no al repo)
Bases de datos/output_asamblea_2023/
Bases de datos/tutelas-salud/raw/
Bases de datos/tutelas-salud/tasas-tutela-salud.json
Bases de datos/tutelas-salud/ips/
Bases de datos/tutelas-salud/registros/
tools/tutela-analiza/lambda-registro/*.zip

# dependencias node de herramientas locales
node_modules/

# TTF derivados de los woff2 del repo (cache local del generador de imágenes)
tools/presidencias-comisiones/fonts/

# artefacto de build de la Lambda de Caudal (se regenera con build_zip.py)
tools/caudal/lambda/caudal-analiza.zip
tools/tutela-analiza/lambda-analiza/*.zip

# PONAL: el CSV crudo (8,4 GB) y los agregados que van a S3
Bases de datos/PONAL/
Bases de datos/output_ponal/

# tutelas-salud: los PNG que salen del generador de imágenes pesan 1,6 MB cada uno
# (16 MB los diez). Al repo va SOLO la versión servible en tutelas-salud/w/, que
# build_frames.py produce alineada y en WebP: 220 KB en total, 75 KB los que baja
# un celular. Los PNG originales se conservan en local para poder regenerar.
tutelas-salud/*.png

# Material de clientes de Cauce (matrices, boletines, briefs) — el repo es público
# OJO: git no puede re-incluir un archivo si su DIRECTORIO esta excluido.
# Por eso se excluye con /* y se reabre img/ paso a paso. Un "!caudalxcauce/"
# pelado des-niega el directorio entero y deja los PDF/XLSX de cliente
# listos para que un `git add -A` los suba a este repo, que es PUBLICO.
caudalxcauce/*
!caudalxcauce/img/
caudalxcauce/img/*
!caudalxcauce/img/mapa-rio-azul.webp
!caudalxcauce/img/mapa-ciudad.webp
!caudalxcauce/img/topo.webp
!caudalxcauce/img/topo-claro.webp
tools/leyes-senado/*.zip
Bases de datos/pronosticos/

# Estado local de wrangler para ayuda-sismo (D1 de pruebas)
ayuda-sismo/worker/.wrangler/
Bases de datos/brief/
# Secretos de desarrollo local del worker de ayuda-sismo (nunca al repo)
ayuda-sismo/worker/.dev.vars

# Notas de trabajo: se quedan en el disco, no se publican.
# Tenían cuenta AWS, nombres de clientes, tarifas y endpoints, en un repo
# público. Claude Code las sigue leyendo igual desde el disco.
CLAUDE.md

# Situación financiera personal: ingresos, saldos, tasas y compromisos.
# NO estaba cubierta por ninguna regla — 'git add -A' la habría subido a un
# repo público. El contenido se queda en el disco, igual que CLAUDE.md.
Bases de datos/gastos/

# Bytecode de Python: lo genera cualquier import o py_compile de tools/
__pycache__/
*.pyc

# Insumos del cliente Paraguay (CSV TSJE ~96 MB, Excel, docx) — la app vive en brujula-asuncion/
Proyecto BL Paraguay/
# Secrets and local credentials must never enter Git or the static site.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.aws/

# Local audit/build scratch data.
.tmp_*/
tmp/

# salida del build de Cloudflare Pages (brujulapolitica.pages.dev)
_site/
