.DS_Store
**/.DS_Store

# RENADIA · respuestas recogidas (datos, no versionar)
Bases de datos/DNP/respuestas-export/
Bases de datos/leyes-senado/supers/

# Fotos de candidatos · staging local (se suben a S3, no al repo)
fotos-candidatos/pendientes/
fotos-candidatos/subidas/
fotos-candidatos/pendientes.csv

# Datos presidenciales formato endoso (se suben a S3, no al repo)
Bases de datos/output_presidencial_endoso/

# Datos Asamblea 2023 formato endoso (se suben a S3, no al repo)
Bases de datos/output_asamblea_2023/
Bases de datos/tutelas-salud/raw/
Bases de datos/tutelas-salud/tasas-tutela-salud.json
Bases de datos/tutelas-salud/ips/
Bases de datos/tutelas-salud/registros/
tools/tutela-analiza/lambda-registro/*.zip

# dependencias node de herramientas locales
node_modules/

# TTF derivados de los woff2 del repo (cache local del generador de imágenes)
tools/presidencias-comisiones/fonts/

# artefacto de build de la Lambda de Caudal (se regenera con build_zip.py)
tools/caudal/lambda/caudal-analiza.zip
tools/tutela-analiza/lambda-analiza/*.zip

# PONAL: el CSV crudo (8,4 GB) y los agregados que van a S3
Bases de datos/PONAL/
Bases de datos/output_ponal/

# tutelas-salud: los PNG que salen del generador de imágenes pesan 1,6 MB cada uno
# (16 MB los diez). Al repo va SOLO la versión servible en tutelas-salud/w/, que
# build_frames.py produce alineada y en WebP: 220 KB en total, 75 KB los que baja
# un celular. Los PNG originales se conservan en local para poder regenerar.
tutelas-salud/*.png
