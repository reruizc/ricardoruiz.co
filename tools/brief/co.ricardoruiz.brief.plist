<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.ricardoruiz.brief</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ricardoruiz/ricardoruiz.co/tools/brief/run_brief.sh</string>
  </array>
  <!-- diario 07:15 — después de que el rastreo nocturno (19:30) y el digest
       de alertas (lun 07:00) hayan dejado sus archivos. Si el Mac estaba
       dormido, launchd corre la agendada perdida al despertar. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ricardoruiz/ricardoruiz.co/Bases de datos/brief/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ricardoruiz/ricardoruiz.co/Bases de datos/brief/launchd.err.log</string>
</dict>
</plist>
