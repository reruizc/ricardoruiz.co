<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Congreso cada 6 horas (nov-2026). Las corridas completas de co.ricardoruiz.leyes-diario
     van a las 08:00 y 19:30; esta suma 02:00 y 14:00 solo con Cámara, Senado, órdenes del
     día, dataset y monitoreo. No publica estado ni latido (CAUDAL_PUBLICA=no): eso es de la
     corrida completa. run_diario.sh tiene candado, así que nunca corren dos a la vez.
     Instalar: cp a ~/Library/LaunchAgents/ y launchctl bootstrap gui/$(id -u) <ruta>. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>co.ricardoruiz.caudal-congreso-6h</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ricardoruiz/ricardoruiz.co/tools/leyes-senado/run_diario.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CAUDAL_ETAPAS</key>
    <string>red_lista,senado_radicados,senado_upload,camara_radicados,camara_upload,camara_viva,en_vivo,ordenes_*,camara_fichas,dataset_*,texto_index,monitor_congreso</string>
    <key>CAUDAL_PUBLICA</key><string>no</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/ricardoruiz/ricardoruiz.co/Bases de datos/leyes-senado/diario/congreso-6h.out.log</string>
  <key>StandardErrorPath</key><string>/Users/ricardoruiz/ricardoruiz.co/Bases de datos/leyes-senado/diario/congreso-6h.err.log</string>
</dict>
</plist>
