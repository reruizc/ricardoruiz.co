<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.ricardoruiz.pronosticos</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ricardoruiz/ricardoruiz.co/tools/pronosticos/run_pronosticos.sh</string>
  </array>

  <!-- Cada 6 horas en régimen normal.
       Los días 11 y 12 de agosto de 2026 se densifica a cada 2 h en horario
       hábil: el 11 en la tarde el Centro Democrático anuncia candidato (es el
       bloque que define la elección) y el 12 en la mañana se vota. Sin esto,
       el comunicado podía tardar hasta 6 h en aparecer en el tablero.
       Tras el 12 se pueden borrar los bloques con <key>Day</key>. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>10</integer></dict>

    <!-- martes 11: seguimiento del comunicado del Centro Democrático -->
    <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>10</integer></dict>

    <!-- miércoles 12: día de la votación -->
    <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>10</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/ricardoruiz/ricardoruiz.co/Bases de datos/pronosticos/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ricardoruiz/ricardoruiz.co/Bases de datos/pronosticos/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
