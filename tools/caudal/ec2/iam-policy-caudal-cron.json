{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketPrivadoCaudal",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::caudal-legislativo"
    },
    {
      "Sid": "ObjetosPrivadosCaudal",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::caudal-legislativo/*"
    },
    {
      "Sid": "BucketPublicoListar",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::elecciones-2026",
      "Condition": {"StringLike": {"s3:prefix": ["ricardoruiz.co/congreso-2026/output/*", "ricardoruiz.co/bases de datos/*"]}}
    },
    {
      "Sid": "ObjetosPublicosQueEscribeElCron",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::elecciones-2026/ricardoruiz.co/congreso-2026/output/*",
        "arn:aws:s3:::elecciones-2026/ricardoruiz.co/bases de datos/*"
      ]
    },
    {
      "Sid": "LeerLaKeyDeDeepSeekDeLaLambda",
      "Effect": "Allow",
      "Action": ["lambda:GetFunctionConfiguration"],
      "Resource": "arn:aws:lambda:us-east-1:167386641785:function:caudal-analiza"
    }
  ]
}
