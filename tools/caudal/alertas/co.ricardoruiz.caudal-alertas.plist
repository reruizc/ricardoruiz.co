<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Caudal · Alertas — agente de launchd.

  Es un agente APARTE del de leyes-diario a propósito: el rastreo y las alertas
  son dos procesos con dueños distintos, y encadenarlos haría que un cambio en
  uno pudiera romper el otro.

  Horario: LUNES 07:00 y VIERNES 12:00 (decisión de Ricardo, ago-2026). Dos
  correos por semana en vez de dos por día: el lunes abre la semana con todo lo
  acumulado desde el viernes, y el viernes la cierra.

  Por qué las 07:00 del lunes NO se quedan cortas aunque el rastreo corra a las
  08:00: a esa hora el dato fresco es el que subió el rastreo del DOMINGO 19:30,
  que ya está completo. Entre la medianoche y las 7 a.m. del lunes no se radica
  nada, así que esperar al rastreo de las 08:00 no agregaría ninguna señal —
  solo retrasaría el correo. (Ojo si algún día se adelanta el horario del
  rastreo: la corrida medida tarda ~50 min, no los ~20 que decía esta nota.)

  Las dos horas caen antes de las 14:00, así que `momento_de()` las clasifica
  como corrida de la 'mañana' y no hace falta pasarle `--momento` al motor.
  Los destinos de tipo sector envían en toda corrida; solo un cliente con
  cadencia 'semanal' quedaría atado al lunes.

  Si el Mac estaba dormido a esa hora, launchd dispara la corrida perdida al
  despertar (una sola vez, no una por cada hora perdida). El estado del motor
  evita que eso reenvíe nada ya enviado.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.ricardoruiz.caudal-alertas</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ricardoruiz/ricardoruiz.co/tools/caudal/alertas/run_alertas.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ricardoruiz/ricardoruiz.co</string>

  <key>StartCalendarInterval</key>
  <array>
    <!-- lunes 07:00 · abre la semana -->
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <!-- viernes 12:00 · cierra la semana -->
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/ricardoruiz/ricardoruiz.co/tools/caudal/alertas/datos/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ricardoruiz/ricardoruiz.co/tools/caudal/alertas/datos/launchd.err.log</string>

  <!-- launchd arranca con un PATH mínimo; el .sh lo fija igual, esto es cinturón
       y tirantes para cuando alguien invoque el motor directo desde el plist. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- No relanzar si falla: una corrida fallida se reintenta en el siguiente
       disparo, no en bucle. Un bucle contra la Lambda cuesta plata y, si el
       fallo es un tercero caído, no arregla nada. -->
  <key>KeepAlive</key>
  <false/>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
