{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::elecciones-2026/ricardoruiz.co/brujula-asuncion/respuestas/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::elecciones-2026",
      "Condition": {"StringLike": {"s3:prefix": "ricardoruiz.co/brujula-asuncion/respuestas/*"}}
    }
  ]
}
