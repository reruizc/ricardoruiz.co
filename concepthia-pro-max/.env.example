# No credentials are needed for crawling, extraction, or local retrieval.
# Set one provider only to use `concepthia_pilot.answer`; never commit .env.
CONCEPTHIA_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-v4-flash.
CONCEPTHIA_DEEPSEEK_MODEL=

OPENAI_API_KEY=
# Optional. Defaults to gpt-5.
CONCEPTHIA_OPENAI_MODEL=

# Set these only in the later S3 milestone; never commit .env.
AWS_REGION=
CONCEPTHIA_S3_BUCKET=
